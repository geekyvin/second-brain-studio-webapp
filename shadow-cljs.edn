{:nrepl {:port 8777}

 :source-paths ["src" "test"]

 :dependencies
 [[reagent "1.1.1"]
  [re-frame "1.4.2"]
  [day8.re-frame/tracing "0.6.2"]
  [day8.re-frame/re-frame-10x "1.9.3"]
  [cljs-ajax "0.8.4"]
  [binaryage/devtools "1.0.6"]
  [cljs-http "0.1.46"]
  [ring-cors "0.1.13"]]

 :dev-http
 {8280 "resources/public"
  8290 "target/browser-test"}

 :builds
 {:app
  {:target     :browser
   :output-dir "resources/public/js/compiled"
   :asset-path "/js/compiled"
   :modules
   {:app {:init-fn second-brain-studio-webapp.core/init}}
   :devtools
   {:preloads [day8.re-frame-10x.preload]
    :watch-dirs ["src"]
    :after-load second-brain-studio-webapp.core/init}
   :dev
   {:compiler-options
    {:source-map true
     :closure-defines
     {re-frame.trace.trace-enabled?        true
      day8.re-frame.tracing.trace-enabled? true}}}
   :release
   {:build-options
    {:ns-aliases
     {day8.re-frame.tracing day8.re-frame.tracing-stubs}}}
   :npm-deps {"amazon-cognito-identity-js" "6.3.7"
             "jwt-decode" "3.1.2"}}
  
  :test
  {:target    :browser-test
   :test-dir  "resources/public/js/test"
   :ns-regexp "-test$"
   :runner-ns second-brain-studio-webapp.test-runner
   :devtools
   {:http-port 8290
    :http-root "resources/public/js/test"}}}}

